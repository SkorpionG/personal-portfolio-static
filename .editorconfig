# EditorConfig helps maintain consistent coding styles across various editors and IDEs.
# More information: https://editorconfig.org

root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# HTML files (using 4 spaces to match project formatting)
[*.{html,htm}]
indent_size = 4

# JavaScript and JSON files
[*.{js,mjs,cjs,json}]
indent_size = 2

# Stylesheets (CSS, SCSS)
[*.{css,scss,sass,less}]
indent_size = 2

# Markdown documentation (preserve trailing spaces used for line breaks)
[*.md]
indent_size = 2
trim_trailing_whitespace = false
